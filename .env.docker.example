# Docker Compose environment template
# Copy to `.env` at the repository root (Compose loads it automatically).
# Never commit real credentials.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Browser origin allowed by API CORS (must match the URL you open)
CLIENT_URL=http://localhost:5173

# Embedded in the frontend image at build time (browser ? API)
VITE_API_URL=http://localhost:5000/api/v1
