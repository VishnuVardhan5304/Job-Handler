# Frontend environment template
# Copy to `.env` in this folder if you need to override the default.
# Vite embeds VITE_* values at build/dev start time.

# Backend API base URL (must be reachable from the browser)
VITE_API_URL=http://localhost:5000/api/v1

# Optional auth token stub for future RBAC (leave empty in MVP)
# VITE_API_TOKEN=
