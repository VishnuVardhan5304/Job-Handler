# Backend environment template
# Copy to `.env` in this folder and replace placeholders.
# Never commit real credentials.

# HTTP port for the FastAPI API
PORT=5000

# Neon PostgreSQL pooled connection string
# Neon Console ? Connection details ? pooled ? database: neondb
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Allowed browser origin for CORS (Vite dev server or Docker UI URL)
CLIENT_URL=http://localhost:5173

# Optional: production | development | test
# ENVIRONMENT=development
