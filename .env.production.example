# Production / single-host deploy environment template
# Copy to `.env.production` on the server (never commit real credentials).

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Public URL of the UI (CORS). Example: https://jobs.example.com
CLIENT_URL=https://jobs.example.com

# Public API base URL embedded in the frontend build.
# Example: https://api.jobs.example.com/api/v1
# If UI and API share one host via reverse proxy, use that public API URL.
VITE_API_URL=https://api.jobs.example.com/api/v1

# Host port mappings (optional)
BACKEND_PORT=5000
FRONTEND_PORT=80
